# Tripo 3D API Configuration
# Get your API key from https://platform.tripo3d.ai/
TRIPO_API_KEY=your_tripo_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Optional: Set to True to allow mock generation fallback when no API key is provided
ALLOW_MOCK_FALLBACK=True

# Future Storage Integration
FIREBASE_STORAGE_BUCKET=
AWS_S3_BUCKET=
